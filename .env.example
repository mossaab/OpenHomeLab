# OpenHomeLab environment variables
# Copy to .env (for docker-compose) or export in your shell (for local dev).

# Port the HTTP server listens on
PORT=1214

# Location of the SQLite database file
DB_PATH=./data/database.sqlite

# REQUIRED in production (NODE_ENV=production).
# Must be a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=

# Optional: 64-char hex AES-256 key used to encrypt SSH credentials at rest.
# If empty, the app generates one and stores it in the database on first run.
# To generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: never change this key after credentials are stored — changing it makes
# all saved SSH passwords/private keys undecryptable (you would have to re-enter them).
APP_ENCRYPTION_KEY=

# --- docker-compose.yml (prod, pre-built GHCR image) only ---

# Version tag of the pre-built image to run. Pin to a release (e.g. v1.0.1)
# for reproducible upgrades, or keep latest to track the newest release.
OPENHOMELAB_VERSION=latest

# Image registry/repository. Only change it if you mirror the image elsewhere
# (e.g. ghcr.io/other-user/new-repo).
OPENHOMELAB_IMAGE=ghcr.io/mossaab/openhomelab
